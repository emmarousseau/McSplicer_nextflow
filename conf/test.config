/*
    Test configuration — runs with example data and minimal resources
*/

params {
    input    = "${projectDir}/assets/samplesheet.tsv"
    outdir   = './results_test'
    read_len = 151
    gene_id  = 'ENSG00000145293'
}

process {
    withLabel: 'process_low' {
        cpus   = 1
        memory = '1.GB'
        time   = '10.m'
    }

    withLabel: 'process_medium' {
        cpus   = 1
        memory = '2.GB'
        time   = '30.m'
    }

    withLabel: 'process_high' {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
    }
}
