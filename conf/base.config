/*
    Base resource configuration for McSplicer pipeline
*/

process {
    withLabel: 'process_low' {
        cpus   = 1
        memory = '2.GB'
        time   = '1.h'
    }

    withLabel: 'process_medium' {
        cpus   = 2
        memory = '8.GB'
        time   = '4.h'
    }

    withLabel: 'process_high' {
        cpus   = 4
        memory = '32.GB'
        time   = '12.h'
    }

    stageInMode   = 'copy'
    errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'
}
