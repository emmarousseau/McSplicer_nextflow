/*
    SLURM cluster configuration for McSplicer pipeline
*/

process {
    executor = 'slurm'

    withLabel: 'process_low' {
        cpus   = 1
        memory = '4.GB'
        time   = '1.h'
        queue  = 'short'
    }

    withLabel: 'process_medium' {
        cpus   = 2
        memory = '16.GB'
        time   = '8.h'
        queue  = 'normal'
    }

    withLabel: 'process_high' {
        cpus   = 4
        memory = '64.GB'
        time   = '24.h'
        queue  = 'long'
    }
}

executor {
    queueSize       = 100
    submitRateLimit = '10/1min'
}
