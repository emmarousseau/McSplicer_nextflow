/*
========================================================================================
    McSplicer Nextflow Pipeline Configuration
========================================================================================
*/

params {
    input            = null
    outdir           = './results'
    read_len         = 151
    gene_id          = ''
    prefix           = ''
    bootstraps       = 0
    anno             = 'n'
    paired_end       = false
    skip_preprocess  = false
    publish_dir_mode = 'copy'

    // Resource caps
    max_memory = '128.GB'
    max_cpus   = 16
    max_time   = '240.h'
}

includeConfig 'conf/base.config'

profiles {
    slurm {
        includeConfig 'conf/slurm.config'
    }

    lsf {
        process.executor = 'lsf'
        process.queue    = 'normal'
    }

    test {
        includeConfig 'conf/test.config'
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
}

manifest {
    name            = 'McSplicer'
    author          = 'McSplicer Team'
    description     = 'Nextflow pipeline for splice site usage estimation via McSplicer'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}
